{
  // F5 runs EDGEquest in an extension development host. Build first: npm run build.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run EDGEquest",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/edgequest"],
      "outFiles": ["${workspaceFolder}/extensions/edgequest/dist/**/*.js"]
    }
  ]
}
